# ── CWETR Frontend environment ────────────────────────────────
# Copy to .env.local for development.

# Media source: "placeholder" (brand SVGs, offline) | "google-photos" (CUTM album)
MEDIA_PROVIDER=placeholder

# Official CUTM Google Photos album share URL (required when MEDIA_PROVIDER=google-photos)
GOOGLE_PHOTOS_ALBUM_URL=

# Laravel backend REST API base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Public site URL (used for metadata / canonical / sitemap)
NEXT_PUBLIC_SITE_URL=https://resorts.cutm.ac.in
