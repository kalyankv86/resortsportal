# ── CWETR Frontend environment ────────────────────────────────
# Copy to .env.local for development.

# Media source: "library" (local files ingested from the CUTM Google Photos
# album, default when the manifest is populated) | "placeholder" (brand SVGs)
MEDIA_PROVIDER=library

# Where Nginx serves the ingested library from (see scripts/ingest-google-photos.mjs)
NEXT_PUBLIC_MEDIA_BASE=/media/library

# Official CUTM Google Photos album — source for the ingest script
GOOGLE_PHOTOS_ALBUM_URL=https://photos.app.goo.gl/a4a4uCXvkiYRb8eo8

# Laravel backend REST API base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Public site URL (used for metadata / canonical / sitemap)
NEXT_PUBLIC_SITE_URL=https://resorts.cutm.ac.in
